# ============================================
# WordPress REST API (Headless CMS)
# ============================================
# Base URL for WordPress REST API (server-side only)
WORDPRESS_API_URL=https://your-wordpress-host.example/wp-json/wp/v2

# ============================================
# HubSpot (Lead Capture & CRM)
# ============================================
# Portal ID (find in HubSpot Settings > Account Setup > Account Defaults)
HUBSPOT_PORTAL_ID=51808566

# Default form ID, used wherever a route-specific one below isn't set
HUBSPOT_FORM_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Form IDs (find in Forms > Embed > Form ID)
HUBSPOT_FORM_ID_SOLICITUD=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_FORM_ID_RETIRO=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_FORM_ID_WAITLIST=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Private App Token (optional, for enhanced API access)
# HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# Minimum seconds between form initialization and submission (anti-bot)
LEAD_MIN_SUBMIT_SECONDS=3

# ============================================
# AI Provider (Chatbot & Recommendations)
# ============================================
# Primary provider: "groq" (recommended, faster) or "gemini"
AI_PROVIDER=groq

# API key for whichever provider AI_PROVIDER points at (get a Groq key from
# console.groq.com, a Gemini key from ai.google.dev). One key, one env var —
# src/app/api/chat/route.ts reads AI_API_KEY regardless of provider, it does
# not read GROQ_API_KEY or GEMINI_API_KEY.
AI_API_KEY=gsk_your_api_key_here

# Model override (optional, defaults: llama-3.1-8b-instant for Groq, gemini-1.5-flash for Gemini)
# AI_MODEL=llama-3.1-8b-instant
# AI_MODEL=gemini-1.5-flash

# ============================================
# Anti-spam (Cloudflare Turnstile)
# ============================================
# Get site key and secret from Cloudflare Dashboard > Turnstile
# If both are empty, Turnstile is disabled (graceful degradation)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
