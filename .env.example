# WordPress REST API base URL (server-side)
WORDPRESS_API_URL=https://your-wordpress-host.example/wp-json/wp/v2

# HubSpot IDs and token (server-side)
HUBSPOT_PORTAL_ID=0000000
HUBSPOT_FORM_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_FORM_ID_SOLICITUD=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_FORM_ID_RETIRO=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_FORM_ID_WAITLIST=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token
LEAD_MIN_SUBMIT_SECONDS=4

# AI provider and key (server-side)
AI_PROVIDER=gemini
AI_API_KEY=your-ai-provider-key
# Optional model override (defaults: gemini-1.5-flash / llama-3.1-8b-instant)
AI_MODEL=

# Cloudflare Turnstile anti-spam (optional). Leave empty to keep it disabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
